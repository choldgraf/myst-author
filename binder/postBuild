#!/bin/bash
set -euo pipefail
npm ci
npm install -g mystmd
npm run build
mkdir -p ~/.jupyter
ln -sf "$PWD/binder/jupyter_server_config.py" ~/.jupyter/jupyter_server_config.py

# The JupyterLab extension, which talks to the host server that jupyter_server_config.py sets up.
npm run build -w packages/jupyterlab
labextensions="$(jupyter --data-dir)/labextensions/@myst-author"
mkdir -p "$labextensions"
ln -sfn "$PWD/packages/jupyterlab/dist/labextension" "$labextensions/jupyterlab"

# VS Code in the browser (jupyter-vscode-proxy launches it), with the MyST Author extension.
# The standalone release bundles its own Node. conda-forge's code-server needs an older Node than this repo.
curl -fsSL https://code-server.dev/install.sh | sh -s -- --method=standalone --prefix="$HOME/.local"
npm run package -w packages/vscode
node packages/vscode/deps.mjs # the extensions it depends on, until they are published (see deps.mjs)
for vsix in packages/vscode/deps/*.vsix packages/vscode/myst-author.vsix; do
  ~/.local/bin/code-server --install-extension "$vsix"
done
# A Binder is a throwaway copy of this repo, so skip the "trust this folder?" prompt that disables extensions.
mkdir -p ~/.local/share/code-server/User
echo '{"security.workspace.trust.enabled": false}' > ~/.local/share/code-server/User/settings.json

// GitHub Codespaces: VS Code with the MyST Author extension, plus the web app on port 4321.
// The extension starts when you open a Markdown file; the tour opens on start.
{
  "name": "MyST Author",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:24",
  "postCreateCommand": "npm ci && npm install -g mystmd && npm run package -w packages/vscode",
  // `code` only reaches the editor once it has attached, so install the extension here rather than in postCreateCommand.
  "postAttachCommand": {
    "extension": "code --install-extension packages/vscode/myst-author.vsix",
    "app": "npm start -- docs/examples/tour"
  },
  "forwardPorts": [4321],
  "portsAttributes": {
    "4321": { "label": "MyST Author", "onAutoForward": "notify" }
  },
  "customizations": {
    "codespaces": { "openFiles": ["docs/examples/tour/index.md"] }
  }
}

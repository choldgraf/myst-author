{
  "name": "myst-author-vscode",
  "displayName": "MyST Author",
  "description": "MyST language features, live preview and a live editor.",
  "version": "0.0.1",
  "private": true,
  "publisher": "myst-author",
  "repository": {
    "type": "git",
    "url": "https://github.com/choldgraf/myst-author"
  },
  "engines": {
    "vscode": "^1.101.0"
  },
  "main": "dist/extension.js",
  "files": [
    "dist"
  ],
  "activationEvents": [
    "onLanguage:markdown",
    "onNotebook:jupyter-notebook"
  ],
  "contributes": {
    "customEditors": [
      {
        "viewType": "mystAuthor.live",
        "displayName": "MyST Live Editor",
        "selector": [
          {
            "filenamePattern": "*.md"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "mystAuthor.openPreview",
        "title": "MyST: Open Preview to the Side"
      },
      {
        "command": "mystAuthor.toggleLive",
        "title": "MyST: Toggle Live Editor",
        "icon": "$(book)"
      },
      {
        "command": "mystAuthor.showLog",
        "title": "MyST: Show Log"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "mystAuthor.toggleLive",
          "when": "resourceLangId == markdown || activeCustomEditorId == mystAuthor.live",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "MyST Author",
      "properties": {
        "mystAuthor.serverPath": {
          "type": "string",
          "default": "",
          "description": "Path to a mystmd-lsp server script, such as dist/server.cjs from a mystmd-lsp clone, to use instead of the bundled one. Reload the window after changing it."
        },
        "mystAuthor.execute": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Run code cells and inline `{eval}` expressions when mystmd builds, with `myst start --execute`. This runs the project's code, and needs Jupyter. Turn it off to build with saved outputs only. Reload the window after changing it."
        }
      }
    },
    "configurationDefaults": {
      "markdown.suggest.paths.enabled": false
    }
  },
  "extensionDependencies": [
    "myst-author.myst-syntax"
  ],
  "scripts": {
    "build": "node build.mjs",
    "package": "node build.mjs && vsce package --no-dependencies --skip-license -o myst-author.vsix"
  },
  "devDependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@myst-author/lsp-client": "*",
    "@myst-author/preview": "*",
    "@types/react": "^19.3.0",
    "@types/vscode": "~1.91.0",
    "@vscode/vsce": "^4.0.0",
    "codemirror": "^6.0.2",
    "esbuild": "^0.28.2",
    "katex": "^0.15.6",
    "myst-syntax": "^0.0.1",
    "mystmd-client": "github:choldgraf/mystmd-client",
    "mystmd-lsp": "^0.0.6",
    "punycode": "^2.3.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vscode-languageclient": "^10.1.2"
  }
}

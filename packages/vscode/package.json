{
  "name": "myst-author-vscode",
  "displayName": "MyST Author",
  "description": "MyST reference intelligence and live preview.",
  "version": "0.0.1",
  "private": true,
  "publisher": "myst-author",
  "repository": {
    "type": "git",
    "url": "https://github.com/choldgraf/myst-author"
  },
  "engines": {
    "vscode": "^1.91.0"
  },
  "main": "dist/extension.js",
  "files": [
    "dist"
  ],
  "activationEvents": [
    "onLanguage:markdown",
    "onNotebook:jupyter-notebook"
  ],
  "contributes": {
    "customEditors": [
      {
        "viewType": "mystAuthor.live",
        "displayName": "MyST Live Editor",
        "selector": [
          {
            "filenamePattern": "*.md"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "mystAuthor.openPreview",
        "title": "MyST: Open Preview to the Side"
      },
      {
        "command": "mystAuthor.toggleLive",
        "title": "MyST: Toggle Live Editor",
        "icon": "$(book)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "mystAuthor.toggleLive",
          "when": "resourceLangId == markdown || activeCustomEditorId == mystAuthor.live",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "package": "node build.mjs && vsce package --no-dependencies --skip-license -o myst-author.vsix"
  },
  "devDependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@myst-author/lsp-client": "*",
    "mystmd-lsp": "^0.0.1",
    "@myst-author/mystmd": "*",
    "@myst-author/preview": "*",
    "@types/react": "^19.3.0",
    "@types/vscode": "~1.91.0",
    "@vscode/vsce": "^4.0.0",
    "codemirror": "^6.0.2",
    "codemirror-lang-myst": "*",
    "esbuild": "^0.28.2",
    "katex": "^0.15.6",
    "punycode": "^2.3.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^3.4.19",
    "vscode-languageclient": "^10.1.2"
  }
}

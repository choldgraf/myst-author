{
  "name": "myst-author-vscode",
  "displayName": "MyST Author",
  "description": "MyST reference intelligence and live preview.",
  "version": "0.0.1",
  "private": true,
  "publisher": "myst-author",
  "engines": {
    "vscode": "^1.91.0"
  },
  "main": "dist/extension.js",
  "activationEvents": [
    "workspaceContains:myst.yml",
    "onLanguage:markdown"
  ],
  "contributes": {
    "commands": [
      {
        "command": "mystAuthor.openPreview",
        "title": "MyST: Open Preview to the Side"
      }
    ]
  },
  "scripts": {
    "build": "node build.mjs"
  },
  "devDependencies": {
    "@myst-author/lsp": "*",
    "@myst-author/preview": "*",
    "@myst-theme/styles": "^1.4.1",
    "@tailwindcss/typography": "^0.5.20",
    "@types/react": "^19.3.0",
    "@types/vscode": "~1.91.0",
    "esbuild": "^0.28.2",
    "katex": "^0.15.6",
    "punycode": "^2.3.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^3.4.19",
    "vscode-languageclient": "^10.1.2"
  }
}

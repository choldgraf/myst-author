{
  "name": "myst-author-vscode",
  "displayName": "MyST Author",
  "description": "Live preview and a live editor for MyST projects, on top of the MyST Language Server extension.",
  "version": "0.0.1",
  "private": true,
  "publisher": "myst-author",
  "repository": {
    "type": "git",
    "url": "https://github.com/choldgraf/myst-author"
  },
  "engines": {
    "vscode": "^1.101.0"
  },
  "main": "dist/extension.js",
  "files": [
    "dist"
  ],
  "activationEvents": [
    "workspaceContains:**/myst.yml"
  ],
  "contributes": {
    "customEditors": [
      {
        "viewType": "mystAuthor.live",
        "displayName": "MyST Live Editor",
        "selector": [
          {
            "filenamePattern": "*.md"
          }
        ],
        "priority": "option"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "mystAuthor.toc",
          "name": "MyST TOC"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "mystAuthor.toc",
        "contents": "Open a page of a MyST project (a folder with myst.yml) to see its table of contents."
      }
    ],
    "commands": [
      {
        "command": "mystAuthor.openPreview",
        "title": "MyST: Open Preview to the Side"
      },
      {
        "command": "mystAuthor.toggleLive",
        "title": "MyST: Toggle Live Editor",
        "icon": "$(book)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "mystAuthor.toggleLive",
          "when": "resourceLangId == markdown || activeCustomEditorId == mystAuthor.live",
          "group": "navigation"
        }
      ]
    }
  },
  "extensionDependencies": [
    "myst-author.mystmd-lsp-vscode"
  ],
  "scripts": {
    "build": "node build.mjs",
    "package": "node build.mjs && vsce package --no-dependencies --skip-license -o myst-author.vsix"
  },
  "devDependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@myst-author/lsp-client": "*",
    "@myst-author/preview": "*",
    "@types/react": "^19.3.0",
    "@types/vscode": "~1.91.0",
    "@vscode/vsce": "^4.0.0",
    "codemirror": "^6.0.2",
    "esbuild": "^0.28.2",
    "katex": "^0.15.6",
    "myst-syntax": "^0.0.1",
    "mystmd-client": "github:choldgraf/mystmd-client",
    "punycode": "^2.3.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vscode-languageclient": "^10.1.2"
  }
}

{
  "name": "myst-author-vscode",
  "displayName": "MyST Author",
  "description": "MyST reference intelligence and live preview.",
  "version": "0.0.1",
  "private": true,
  "publisher": "myst-author",
  "repository": {
    "type": "git",
    "url": "https://github.com/choldgraf/myst-author"
  },
  "engines": {
    "vscode": "^1.91.0"
  },
  "main": "dist/extension.js",
  "files": [
    "dist"
  ],
  "activationEvents": [
    "onLanguage:markdown",
    "onNotebook:jupyter-notebook"
  ],
  "contributes": {
    "commands": [
      {
        "command": "mystAuthor.openPreview",
        "title": "MyST: Open Preview to the Side"
      }
    ]
  },
  "scripts": {
    "build": "node build.mjs",
    "package": "node build.mjs && vsce package --no-dependencies --skip-license -o myst-author.vsix"
  },
  "devDependencies": {
    "@myst-author/lsp": "*",
    "@myst-author/preview": "*",
    "@types/react": "^19.3.0",
    "@types/vscode": "~1.91.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "katex": "^0.15.6",
    "punycode": "^2.3.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^3.4.19",
    "vscode-languageclient": "^10.1.2"
  }
}
